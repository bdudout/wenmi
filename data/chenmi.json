    {
     "raw": "轉烈武兄鑒",
     "status": "literal",
     "zh": "轉烈武兄鑒：",
     "fr": "À transmettre à frère Liewu :",
     "note": "烈武 = 柏文蔚 (字 烈武), candidat."
    },
    {
     "raw": "山東方面如欲兄當統一事任",
     "status": "literal",
     "zh": "山東方面如欲兄當統一事任，",
     "fr": "si, du côté du Shandong, on souhaite que vous preniez la direction unifiée,",
     "note": ""
    },
    {
     "raw": "可直承諾",
     "status": "literal",
     "zh": "可直承諾；",
     "fr": "vous pouvez accepter directement ;",
     "note": ""
    },
    {
     "raw": "請溥泉偕劃",
     "status": "provisional",
     "zh": "請溥泉偕{行}。",
     "fr": "priez Puquan (Zhang Ji) de vous accompagner.",
     "note": "劃 → {行} : 1 chiffre (9527 → 3527). 溥泉 = 張繼."
    },
    {
     "raw": "此間當盡力援助",
     "status": "literal",
     "zh": "此間當盡力援助。",
     "fr": "D’ici, nous vous aiderons de toutes nos forces.",
     "note": ""
    },
    {
     "raw": "如何盻覆",
     "status": "provisional",
     "zh": "如何，{盼}覆。",
     "fr": "Qu’en pensez-vous ? J’attends la réponse.",
     "note": "盻 → {盼} : contexte ; même code 盻 (4171) qu’en 容密, différence probable de livre de code."
    },
