   "segments": [
    {
     "raw": "小詠鳳三兄鑒",
     "status": "provisional",
     "zh": "小、詠、鳳三兄鑒：",
     "fr": "Aux trois frères Xiao, Yong et Feng :",
     "note": "鳳 = 陳嘉會 (鳳先) ; 小 (aussi en N16) et 詠 non identifiés (小垣 = 李書城 ?)."
    },
    {
     "raw": "致黎岑及各省電頗難著筆",
     "status": "literal",
     "zh": "致黎、岑及各省電頗難著筆。",
     "fr": "Le télégramme à Li [Yuanhong], à Cen [Chunxuan] et aux provinces est très difficile à rédiger.",
     "note": "岑 = 岑春煊, vice-chef du Conseil militaire (軍務院)."
    },
    {
     "raw": "苟主張一不恐有歧趨之嫌",
     "status": "provisional",
     "zh": "苟主張{不}{一}，恐有歧趨之嫌；",
     "fr": "si nos positions ne sont pas unanimes, on risque de paraître divisés ;",
     "note": "一不 → {不}{一} : contexte ; les deux groupes (9950 一, 9958 不) sont probablement inversés à l’encodage."
    },
    {
     "raw": "若如來電云云人必視爲取巧",
     "status": "literal",
     "zh": "若如來電云云，人必視爲取巧。",
     "fr": "si l’on écrit comme le dit votre télégramme, on y verra un calcul opportuniste.",
     "note": ""
    },
    {
     "raw": "請取護國軍同意畎尊處擬稿拍發爲盼",
     "status": "provisional",
     "zh": "請取護國軍同意，{由}尊處擬稿拍發爲盼。",
     "fr": "Obtenez l’accord de l’Armée de protection de la nation, puis rédigez le télégramme et envoyez-le de votre côté.",
     "note": "畎 → {由} : 1 chiffre (5692 → 5682)."
    },
    {
     "raw": "日態度頗觀望",
     "status": "literal",
     "zh": "日態度頗觀望，",
     "fr": "Le Japon reste très attentiste ;",
     "note": "Cf. l’édition des brouillons, pièce 6 (20/6) : « 實日當局意存觀望 »."
    },
    {
     "raw": "滬同人宜表示強硬主張",
     "status": "literal",
     "zh": "滬同人宜表示強硬主張，",
     "fr": "les camarades de Shanghai doivent afficher une position ferme,",
     "note": ""
    },
    {
     "raw": "軍務院尤須明白",
     "status": "literal",
     "zh": "軍務院尤須明白。",
     "fr": "et le Conseil militaire surtout doit être clair.",
     "note": ""
    },
    {
     "raw": "近兩日變狀乞電示",
     "status": "literal",
     "zh": "近兩日變狀，乞電示。",
     "fr": "Télégraphiez-moi l’évolution de ces deux derniers jours.",
     "note": ""
    },
    {
     "raw": "興",
     "status": "literal",
     "zh": "興。",
     "fr": "Xing.",
     "note": "Signature de Huang Xing, sans code de jour."
    }
   ],
