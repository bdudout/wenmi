   "segments": [
    {
     "raw": "並轉組鳳小諸公鑒",
     "status": "provisional",
     "zh": "並轉組、鳳、小諸公鑒：",
     "fr": "À transmettre aussi à Zu, Feng, Xiao et aux autres :",
     "note": "組 = 譚延闓 (組安), alors à Shanghai ; 鳳 = 陳嘉會 ; 小 : cf. N13."
    },
    {
     "raw": "黎公非準備一二師可靠兵力",
